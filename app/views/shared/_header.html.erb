<%# CSS・・・assets/stylesheets/shared/header.css %>
<header class='top-page-header'>
  <div class='search-bar-contents'>
    <%= link_to image_tag("furima-logo-color.png", class:"furima-icon"), "/" %>
    <%= form_with(url: search_items_path, local: true, method: :get, class: "search-form") do |form|%>
      <%= form.text_field :keyword, value: params[:keyword], placeholder: "キーワードから探す", class: "input-box" %>
      <%= form.button type: :submit, class: "search-button" do %>
        <%= image_tag "search.png", class: "search-icon" %>
      <% end %>
    <% end %>
  </div>
  <div class='nav'>
    <div class='lists-left'>
      <div class="lists-left-btns">
        <div class="all-item-nav-btn", id="all-item-nav-btn">
          <%= link_to "すべて", items_path %>
        </div>
        <div class="category-nav", id="category-nav">
          <div class="category-nav-btn", id="category-nav-btn">カテゴリー</div>
          <ul class="category-nav-list", id="category-nav-list">
            <% @categories.each do |c|%>
              <li>
                <%= link_to c.name, items_path(category_id: c.id) %>
              </li>
            <%end%>
          </ul>
        </div>
        <div class="brand-nav", id="brand-nav">
          <div class="brand-nav-btn" , id="brand-nav-btn">ブランド</div>
          <ul class="brand-nav-list", id="brand-nav-list">
            <% @brands.each do |b|%>
              <li>
                <%= link_to b.name, items_path(brand_id: b.id) %>
              </li>
            <%end%>
          </div>
        </div>
      </div>
      <ul class='lists-right'>
        <% if user_signed_in? %>
          <li>
            <%= link_to current_user.nickname, "#", class: "user-nickname" %>
          </li>
          <li>
            <%= link_to 'ログアウト',
          destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "logout" %>
          </li>
        <% else %>
          <li>
            <%= link_to 'ログイン',
          new_user_session_path,
          class: "login" %>
          </li>
          <li>
            <%= link_to '新規登録',
          new_user_registration_path,
          class: "sign-up" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</header>
