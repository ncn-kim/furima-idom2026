<%= render "shared/header" %>
<div class="user-page">
  <div class="user-page-title">
    <%= "#{@user.nickname}様の情報" %>
  </div>
  <div class="user-info">
    <% if user_signed_in? && current_user == @user %>
      <dl class="user-personal-info">
        <div class="info-row">
          <dt>ニックネーム</dt>
          <dd><%= @user.nickname %></dd>
        </div>
        <div class="info-row">
          <dt>E-mail</dt>
          <dd><%= @user.email %></dd>
        </div>
        <div class="info-row">
          <dt>姓</dt>
          <dd><%= @user.last_name %></dd>
        </div>
        <div class="info-row">
          <dt>姓(カナ)</dt>
          <dd><%= @user.last_name_kana %></dd>
        </div>
        <div class="info-row">
          <dt>名</dt>
          <dd><%= @user.first_name %></dd>
        </div>
        <div class="info-row">
          <dt>名(カナ)</dt>
          <dd><%= @user.first_name_kana %></dd>
        </div>
        <div class="info-row">
          <dt>生年月日</dt>
          <dd><%= @user.birth_date.strftime("%Y年%-m月%-d日") %></dd>
        </div>
      </dl>
    <% end %>
    <dl class="user-active-info">
      <div class="info-row">
        <dt>会員登録日</dt>
        <dd><%= @user.created_at.strftime("%Y年%m月%d日") %></dd>
      </div>
      <div class="info-row">
        <dt>出品商品数</dt>
        <dd><%= "#{@user.items.count}個" %></dd>
      </div>
      <div class="info-row">
        <dt>回覧数合計</dt>
        <dd><%= "#{ViewCount.where(item_id: @user.item_ids).count}回" %></dd>
      </div>
      <div class="info-row">
        <dt>販売済み商品数</dt>
        <dd><%= "#{@user.items.joins(:order).count}個" %></dd>
      </div>
      <div class="info-row">
        <dt>販売合計金額</dt>
        <dd><%= "#{@user.items.joins(:order).sum(:price)}円" %></dd>
      </div>
      <div class="info-row">
        <dt>購入済み商品数</dt>
        <dd><%= "#{@user.orders.count}個" %></dd>
      </div>
      <div class="info-row">
        <dt>購入合計金額</dt>
        <dd><%= "#{@user.orders.joins(:item).sum('items.price')}円" %></dd>
      </div>
    </dl>
  </div>
</div>
<div class="user-page-title">
  <%= "#{@user.nickname}様の出品商品"%>
</div>
<div class="user-products">
  <%# <div class="user-products-filter"></div> %>
  <ul class='item-lists'>
    <% @items.each do |item|%>
      <li class='list'>
        <%= link_to item_path(item) do %>
          <div class='item-img-content'>
            <%= image_tag item.image , class: "item-img" if item.image.attached? %>
            <% if item.order.present? %>
              <div class='sold-out'>
                <span>Sold Out!!</span>
              </div>
            <% end %>
          </div>
          <div class='item-info'>
            <h3 class='item-name'>
              <%= item.name %>
            </h3>
            <div class='item-price'>
              <span><%= item.price %>円<br>
                <%= item.shipping_fee.name %></span>
              <div class='view-counts'>
                <span class='count-print'>回覧数 : <%= item.view_counts.count %></span>
              </div>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </div>
  <%= render "shared/footer" %>
