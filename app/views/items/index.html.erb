<%= render "shared/header" %>
<div class='main'>
  <div class='item-contents'>
    <div class="category-contents">
      <p>カテゴリーリスト</p>
      <div class="category-btn">
        <%= link_to "すべて", items_path %>
        <% @categories.each do |c|%>
          <% next if c.id == 1 %>
          <%= link_to c.name, items_path(category_id: c.id)%>
        <% end %>
      </div>
    </div>
    <div class="item-index-contents">
      <% if params[:category_id].blank? %>
        <h2 class='title'>すべて</h2>
      <% else %>
        <h2 class='title'><%= @category.name %></h2>
      <%end%>
      <div class="subtitle" >
        新規投稿商品
      </div>
      <%= form_with url: items_path, method: :get, local: true do |f|%>
        <%= hidden_field_tag :category_id, params[:category_id] %>
        <%= f.select :sort, [
          ['---', ''],
          ['回覧数高い順', 'view_count_desc'],
          ['回覧数低い順', 'view_count_asc'],
          ['値段高い順', 'price_desc'],
          ['値段低い順', 'price_asc']
        ], { selected: params[:sort] }, { onchange: 'this.form.submit();', style: "text-align:-webkit-center;"}%>
      <% end %>
      <div class="item-main-contents">
        <ul class='item-lists'>
          <% @items.each do |item|%>
            <li class='list'>
              <%= link_to item_path(item) do %>
                <div class='item-img-content'>
                  <%= image_tag item.image , class: "item-img" if item.image.attached? %>
                  <% if item.order.present? %>
                    <div class='sold-out'>
                      <span>Sold Out!!</span>
                    </div>
                  <% end %>
                </div>
                <div class='item-info'>
                  <h3 class='item-name'>
                    <%= item.name %>
                  </h3>
                  <div class='item-price'>
                    <span><%= item.price %>円<br>
                      <%= item.shipping_fee.name %></span>
                    <div class='view-counts'>
                      <span class='count-print'>回覧数 : <%= item.view_counts.count %></span>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
          <% if @items.empty? %>
            <li class='list'>
              <%= link_to '#' do %>
                <%= image_tag "https://tech-master.s3.amazonaws.com/uploads/curriculums/images/Rails1-4/sample.jpg", class: "item-img" %>
                <div class='item-info'>
                  <h3 class='item-name'>
                    商品を出品してね！
                  </h3>
                  <div class='item-price'>
                    <span>99999999円<br>
                      (税込み)</span>
                    <div class='view-counts'>
                      <span class='count-print'>回覧数 : 0</span>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
<%= link_to(new_item_path, class: 'purchase-btn') do %>
  <span class='purchase-btn-text'>出品する</span>
  <%= image_tag 'icon_camera.png' , size: '185x50' ,class: "purchase-btn-icon" %>
<% end %>
<%= render "shared/footer" %>