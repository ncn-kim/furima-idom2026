<%= render "shared/header" %>
<div class='main'>
  <div class='item-contents'>
    <div class="item-index-contents">
      <% if params[:category_id].blank? %>
        <h2 class='title'>すべて</h2>
      <% else %>
        <h2 class='title'><%= @category.name %></h2>
      <% end %>
      <div class="subtitle" >
        <% if params[:brand_id].blank? %>
          すべてのブランド
        <% else %>
          <%= @brand.name %>
        <% end %>
      </div>
      <div class="item-filter">
        <%= form_with url: items_path, method: :get, local: true do |f| %>
          <%= f.select :category_id,
    [['すべて', '']] + @categories.map { |c| [c.name, c.id] },
    { selected: params[:category_id] },
    { onchange: 'this.form.submit();', class: 'filter-select' } %>
          <%= f.select :brand_id,
    [['すべてのブランド', '']] + @brands.map { |b| [b.name, b.id] },
    { selected: params[:brand_id] },
    { onchange: 'this.form.submit();', class: 'filter-select' } %>
          <%= f.select :status,
    [
      ['すべて', ''],
      ['販売中', 'selling'],
      ['売り切れ', 'sold']
    ],
    { selected: params[:status] },
    { onchange: 'this.form.submit();', class: 'filter-select' } %>
          <%= f.select :sort,
    [
      ['---', ''],
      ['回覧数高い順', 'view_count_desc'],
      ['回覧数低い順', 'view_count_asc'],
      ['値段高い順', 'price_desc'],
      ['値段低い順', 'price_asc']
    ],
    { selected: params[:sort] },
    { onchange: 'this.form.submit();', class: 'filter-select' } %>
        <% end %>
        <%= link_to '条件クリア', items_path, class: 'clear-btn' %>
      </div>
      <div class="item-main-contents">
        <ul class='item-lists'>
          <% @items.each do |item|%>
            <li class='list'>
              <%= link_to item_path(item) do %>
                <div class='item-img-content'>
                  <%= image_tag item.image , class: "item-img" if item.image.attached? %>
                  <% if item.order.present? %>
                    <div class='sold-out'>
                      <span>Sold Out!!</span>
                    </div>
                  <% end %>
                </div>
                <div class='item-info'>
                  <h3 class='item-name'>
                    <%= item.name %>
                  </h3>
                  <div class='item-price'>
                    <span><%= item.price %>円<br>
                      <%= item.shipping_fee.name %></span>
                    <div class='view-counts'>
                      <span class='count-print'>回覧数 : <%= item.view_counts.count %></span>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
          <% if @items.empty? %>
            <li class='list'>
              <%= link_to '#' do %>
                <%= image_tag "https://tech-master.s3.amazonaws.com/uploads/curriculums/images/Rails1-4/sample.jpg", class: "item-img" %>
                <div class='item-info'>
                  <h3 class='item-name'>
                    商品を出品してね！
                  </h3>
                  <div class='item-price'>
                    <span>99999999円<br>
                      (税込み)</span>
                    <div class='view-counts'>
                      <span class='count-print'>回覧数 : 0</span>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
<%= link_to(new_item_path, class: 'purchase-btn') do %>
  <span class='purchase-btn-text'>出品する</span>
  <%= image_tag 'icon_camera.png' , size: '185x50' ,class: "purchase-btn-icon" %>
<% end %>
<%= render "shared/footer" %>